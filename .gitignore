# ── Secrets — never commit ──────────────────────────────────────────────
.secrets/
*.env
*.secret
secrets.json
*credentials*.json
*.token

# ── Build output ────────────────────────────────────────────────────────
dist/

# ── Dependencies ────────────────────────────────────────────────────────
node_modules/

# ── Python caches ───────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Logs ────────────────────────────────────────────────────────────────
*.log

# ── Ad / marketing pipeline — local only, NOT part of the published addon ─
ads/
tools/adgen/

# ── Logo render scratch (keep the .svg sources + final .png exports) ─────
store/logo/_*.html

# ── Claude Code local config (agents, settings) — not published ──────────
.claude/

# ── OS / editor cruft ───────────────────────────────────────────────────
Thumbs.db
.DS_Store
*.swp
