# Normalize line endings: LF in the repo and on checkout.
# WoW reads either; this keeps the Windows working tree from showing
# spurious CRLF-only "modifications".
* text=auto eol=lf

# Binary assets — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.mp4  binary
*.mkv  binary
*.zip  binary
*.ico  binary
*.ttf  binary
*.otf  binary
